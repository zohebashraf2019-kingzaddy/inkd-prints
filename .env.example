# Stripe secret key (Dashboard → Developers → API keys). Use sk_test_... first, then sk_live_...
STRIPE_SECRET_KEY=sk_test_xxx

# Added automatically when you connect a Blob store in Vercel (Storage → Create → Blob)
BLOB_READ_WRITE_TOKEN=

# Optional: your live domain, e.g. https://inkdprints.com (otherwise detected automatically)
SITE_URL=

# Optional: "true" to have Stripe calculate sales tax (turn on Stripe Tax first)
STRIPE_AUTOMATIC_TAX=false
